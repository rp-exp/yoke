{
  "name": "yoke",
  "version": "0.0.0",
  "description": "One interface for driving coding-agent harnesses from your own code.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "bun": ">=1.1"
  },
  "exports": {
    ".": "./src/index.ts",
    "./opencode": "./src/adapters/opencode/index.ts",
    "./conformance": "./src/conformance/index.ts"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "*",
    "@cursor/sdk": "*",
    "@opencode-ai/client": "*"
  },
  "peerDependenciesMeta": {
    "@opencode-ai/client": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@cursor/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@opencode-ai/client": "0.0.0-beta-17963",
    "@types/bun": "^1.4.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "conformance:opencode": "bun scripts/run-opencode-conformance.ts",
    "conformance:claude-code": "bun scripts/run-claude-code-conformance.ts"
  }
}
